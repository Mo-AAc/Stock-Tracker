# Copy to .streamlit/secrets.toml on the server and fill in real values.
# This file is a template only - never put a real password or key in it.
# Generate the key with:  python -c "import secrets; print(secrets.token_hex(32))"
[stock_tracker_auth]
username = "admin"
password = "REPLACE-WITH-THE-SERVER-ONLY-PASSWORD"
cookie_key = "REPLACE-WITH-A-64-CHAR-RANDOM-HEX-STRING"
